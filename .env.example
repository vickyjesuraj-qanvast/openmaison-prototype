# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is git-ignored.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Public base URL of the app (used for absolute links + metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# libSQL / SQLite connection string.
# Local file (default, zero setup):   file:./local.db
# Turso (hosted):                     libsql://<db>-<org>.turso.io
DATABASE_URL="file:./local.db"

# Required only when DATABASE_URL points at a hosted Turso database.
DATABASE_AUTH_TOKEN=""

# Secret used to sign session cookies. MUST be set to a long random value.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Billing (Stripe) - not wired up yet, see lib/config.ts for the plan catalog.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
