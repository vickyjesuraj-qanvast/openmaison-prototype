# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is git-ignored.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Public base URL of the app (used for absolute links + metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# libSQL / SQLite connection string.
# Local file (default, zero setup):   file:./local.db
# Turso (hosted):                     libsql://<db>-<org>.turso.io
DATABASE_URL="file:./local.db"

# Required only when DATABASE_URL points at a hosted Turso database.
DATABASE_AUTH_TOKEN=""

# Secret used to sign session cookies. MUST be set to a long random value.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Real services (pending modules S34). The prototype plugs none in: every
# service is a stand-in that says so (lib/services/registry.ts lists each, its
# contract and the one call that swaps it; plug them in lib/services/install.ts).
# The names are 1.0's, so its deployment settings carry over. The app warns at
# start-up when a key below is set but its service is still the stand-in.
# ---------------------------------------------------------------------------
# The scheduler — GET /api/cron/run every 5 minutes with "Authorization: Bearer <CRON_SECRET>".
# Production refuses every cron call (and GET /api/services) while it is unset.
CRON_SECRET=""
# Email (Resend) and WhatsApp (360dialog) — setDeliveryAdapter
# RESEND_API_KEY=""
# D360_API_KEY=""
# D360_API_BASE="https://waba-v2.360dialog.io"
# D360_DEFAULT_TEMPLATE=""
# D360_DEFAULT_TEMPLATE_LANG="en"
# The provider's webhook — POST /api/webhooks/whatsapp?token=<this>. Unset = the webhook answers 503.
# WHATSAPP_WEBHOOK_SECRET=""
# A staging deployment with real keys: only these people get a real message (comma-separated emails / mobiles).
# NOTIFY_ALLOWLIST=""
# Sign-in codes (Twilio Verify) — setSignInProvider
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SERVICE_SID=""
# Payments to OpenMaison (Dodo Payments) — setPaymentProvider; its webhook is POST /api/webhooks/payments
# DODO_PAYMENTS_API_KEY=""
# DODO_PAYMENTS_WEBHOOK_KEY=""
# Xero — setAccountingProvider
# XERO_CLIENT_ID=""
# XERO_CLIENT_SECRET=""
# XERO_REDIRECT_URI=""
# Google (the studio's calendar; Gmail lead sources) — setCalendarSync
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""
# EMAIL_TOKEN_SECRET=""
# Transcription — setTranscriber, and build with NEXT_PUBLIC_TRANSCRIPTION=1
# COPILOT_STT_PROVIDER=""
# DEEPGRAM_API_KEY=""
# PDF files of the papers — setPdfRenderer, and build with NEXT_PUBLIC_PDF_DOWNLOADS=1
# INTERNAL_RENDER_ORIGIN=""
# OpenMaison's / Qanvast's feeds — setFeedSource
# QANVAST_API_URL=""
# Qanvast's listing API (Company › Profile › Listed on Qanvast) — setQanvastListingService; its answers POST to /api/webhooks/qanvast-listing
# QANVAST_WEBHOOK_SECRET=""
# Qanvast's account API (Qanvast Ops › Lead credits · Reviews) — setQanvastAccountService; 1.0 read it through its proxy with the studio's Qanvast id
# NEXT_PUBLIC_QANVAST_COMPANY_ID=""
# The host external systems POST leads to (Company › Integrations › Webhooks) — points at /api/webhooks/leads/<token>
# NEXT_PUBLIC_INTAKE_URL="https://in.openmaison.sg"
# The website's AI Visualizer trial (/site/try) — 1.0's switch: "true" opens it in production, "false" closes it (every trial address 404s).
# Unset, the prototype's demo shows it (lib/visualizer/trial/policy.ts TRIAL_IN_DEMO; a real build sets that false). Set it for the build
# and the server alike: the sitemap and the Visualizer page's Try now are built with the site. 1.0 meant it to go on only with bot
# protection and a lasting rate-limit store plugged in (setBotCheck · setLimitStore in lib/visualizer/trial/server.ts):
# TRIAL_VISUALIZER_ENABLED=""
# (pending modules S41b-3) the no-account Leads · Upload a quote · Quote X-Ray on the website — true opens them, false closes them (a real build: off until set).
# Set it for the build and the server alike, as TRIAL_VISUALIZER_ENABLED: the sitemap and the Leads / Upload a quote pages' Try now are built with the site.
# TRIAL_TOOLS_ENABLED=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# Developers' pages in a production build (404 without it): a sent email's page, /api/dev/email-preview?id=<outbox id>, and
# (pending modules S41) 1.0's AI sandboxes as a bench, /dev/ai-bench — depth, look around, camera moves, clips, extend, plan corners.
# OPENMAISON_DEV_PREVIEWS="1"
